<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DnWModManager.MainWindow"
        Title="DnW Mod Manager"
        Icon="/Assets/app.ico"
        Height="760"
        Width="1140"
        MinHeight="560"
        MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="Rectangle.dropzone">
            <Setter Property="Stroke" Value="{StaticResource TextFaint}"/>
        </Style>
        <Style Selector="Rectangle.dropzone.droptarget">
            <Setter Property="Stroke" Value="{StaticResource Accent}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <Border Background="{StaticResource Surface}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,14" ColumnDefinitions="Auto,*,Auto">

                <Image Source="/Assets/logo.png"
                       Width="38"
                       Height="38"
                       RenderOptions.BitmapInterpolationMode="HighQuality"
                       VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Margin="14,0,20,0"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="DnW Mod Manager"
                                   Classes="title"/>
                        <Border Classes="pill"
                                Margin="10,2,0,0"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Mod Manager is running as administrator."
                                IsVisible="{Binding IsElevated}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA18;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="10"
                                           Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,5,0"/>
                                <TextBlock Text="Administrator"
                                           Classes="muted"
                                           FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Button Classes="primary"
                                Padding="9,2"
                                FontSize="11"
                                Margin="10,2,0,0"
                                VerticalAlignment="Center"
                                Content="{Binding ManagerUpdateText}"
                                ToolTip.Tip="A new Mod Manager version is available. Click here to update."
                                IsVisible="{Binding ManagerHasUpdate}"
                                Command="{Binding UpdateManagerCommand}"/>
                        <Border Classes="pill"
                                Margin="10,2,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding LoaderVersionText}"
                                       Classes="muted"
                                       FontSize="11"/>
                        </Border>
                        <Button Classes="primary"
                                Padding="9,2"
                                FontSize="11"
                                Margin="6,2,0,0"
                                VerticalAlignment="Center"
                                Content="{Binding LoaderUpdateText}"
                                ToolTip.Tip="Update the Mod Loader"
                                IsVisible="{Binding LoaderHasUpdate}"
                                Command="{Binding UpdateLoaderCommand}"/>
                    </StackPanel>

                    <DockPanel Margin="0,3,0,0"
                               HorizontalAlignment="Left"
                               LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Classes="ghost"
                                Content="Change"
                                Margin="8,0,0,0"
                                Command="{Binding ChangeGameFolderCommand}"/>
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding InstallSourceText}"
                                   Classes="muted"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap"/>
                        <TextBlock DockPanel.Dock="Right"
                                   Text=" &#183; "
                                   Classes="muted"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap"/>
                        <Button Classes="link path"
                                FontSize="12"
                                VerticalAlignment="Center"
                                Content="{Binding GameDirectoryText}"
                                ToolTip.Tip="{Binding GameDirectoryText}"
                                Command="{Binding OpenFolderCommand}"
                                CommandParameter="Game"/>
                    </DockPanel>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Classes="secondary"
                            Content="Refresh"
                            Margin="0,0,8,0"
                            Command="{Binding RefreshCommand}"/>
                    <Button Classes="primary"
                            Padding="24,9"
                            Command="{Binding LaunchCommand}"
                            ToolTip.Tip="{Binding PlayTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x25B6;"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="0,0,7,0"/>
                            <TextBlock Text="Play"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="188,*">

            <Border Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0,0,1,0">
                <StackPanel Margin="0,12">
                    <RadioButton Classes="nav"
                                 Content="Installed mods"
                                 GroupName="nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=Installed}"/>
                    <RadioButton Classes="nav"
                                 Content="Issues"
                                 GroupName="nav"
                                 Tag="{Binding IssueBadge}"
                                 Background="{Binding IssueBadgeBrush}"
                                 IsVisible="{Binding HasIssues}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=Issues}"/>
                    <RadioButton Classes="nav"
                                 Content="Get mods"
                                 GroupName="nav"
                                 Tag="{Binding NewModsBadge}"
                                 Background="{StaticResource Accent}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=Browse}"/>
                    <RadioButton Classes="nav"
                                 Content="Log"
                                 GroupName="nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=Log}"/>
                    <RadioButton Classes="nav"
                                 Content="Settings"
                                 GroupName="nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=Settings}"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">

                <DockPanel IsVisible="{Binding IsInstalledPage}"
                           LastChildFill="True">

                    <Border DockPanel.Dock="Top"
                            Classes="card"
                            Margin="20,18,20,0"
                            IsVisible="{Binding ShowHealthCard}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center"
                                        Margin="0,0,14,0">
                                <TextBlock Text="{Binding HealthSummary}"
                                           Classes="heading"/>
                                <TextBlock Text="{Binding HealthHint}"
                                           Classes="muted"
                                           Margin="0,3,0,0"
                                           IsVisible="{Binding HasIssues}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button Classes="secondary"
                                        Content="Install the loader"
                                        Margin="0,0,8,0"
                                        IsVisible="{Binding LoaderMissing}"
                                        Command="{Binding InstallLoaderCommand}"/>
                                <Button Classes="secondary"
                                        Content="View issues"
                                        Margin="0,0,8,0"
                                        IsVisible="{Binding HasIssues}"
                                        Command="{Binding GoToCommand}"
                                        CommandParameter="Issues"/>
                                <Button Classes="primary"
                                        Content="Fix everything"
                                        IsVisible="{Binding RepairableCount, Converter={StaticResource HasValue}}"
                                        Command="{Binding FixEverythingCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                Margin="20,18,20,12">
                        <Button Classes="secondary"
                                Content="Install from zip..."
                                Margin="0,0,8,0"
                                Command="{Binding InstallFromFileCommand}"
                                ToolTip.Tip="Install a mod from a zip file."/>
                        <Button Classes="secondary"
                                Content="Install from folder..."
                                Margin="0,0,8,0"
                                Command="{Binding InstallFromFolderCommand}"/>
                        <Button Classes="primary"
                                Margin="0,0,8,0"
                                IsVisible="{Binding HasUpdates}"
                                Command="{Binding UpdateEverythingCommand}">
                            <TextBlock>
                                <Run Text="Update all ("/><Run Text="{Binding UpdateCount, Mode=OneWay}"/><Run Text=")"/>
                            </TextBlock>
                        </Button>
                        <Button Classes="ghost"
                                Content="Open Mods folder"
                                Command="{Binding OpenFolderCommand}"
                                CommandParameter="Mods"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Padding="20,0,14,20">
                        <ItemsControl ItemsSource="{Binding Mods}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="row">
                                        <Grid ColumnDefinitions="Auto,*,Auto">

                                            <CheckBox Classes="switch"
                                                      Margin="0,2,14,0"
                                                      VerticalAlignment="Top"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanToggle}"
                                                      ToolTip.Tip="{Binding ToggleTooltip}"/>

                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}"
                                                               Classes="heading"/>
                                                    <TextBlock Text="{Binding Version}"
                                                               Classes="muted"
                                                               Margin="7,2,0,0"
                                                               VerticalAlignment="Center"/>
                                                    <Border CornerRadius="9"
                                                            Padding="7,1"
                                                            Margin="9,2,0,0"
                                                            VerticalAlignment="Center"
                                                            Background="{StaticResource SurfaceAlt}">
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   FontSize="11"
                                                                   Foreground="{Binding StatusBrush}"/>
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Text="{Binding Byline}"
                                                           Classes="muted"
                                                           Margin="0,2,0,0"/>

                                                <TextBlock Text="{Binding Description}"
                                                           Classes="body"
                                                           Foreground="{StaticResource TextMuted}"
                                                           Margin="0,6,12,0"
                                                           IsVisible="{Binding Description, Converter={StaticResource HasValue}}"/>

                                                <ItemsControl ItemsSource="{Binding Issues}"
                                                              Margin="0,7,12,0"
                                                              IsVisible="{Binding HasIssues}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal"
                                                                        Margin="0,0,0,3">
                                                                <Ellipse Width="6"
                                                                         Height="6"
                                                                         Margin="0,6,7,0"
                                                                         VerticalAlignment="Top"
                                                                         Fill="{Binding Severity, Converter={StaticResource SeverityBrush}}"/>
                                                                <TextBlock Text="{Binding Title}"
                                                                           Classes="muted"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <ItemsControl ItemsSource="{Binding ResourceFolders}"
                                                              Margin="0,8,12,0"
                                                              IsVisible="{Binding HasResourceFolders}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Classes="dropzone"
                                                                  Margin="0,0,0,4"
                                                                  Background="Transparent"
                                                                  DragDrop.AllowDrop="True">
                                                                <Rectangle Classes="dropzone"
                                                                           Classes.droptarget="{Binding IsDropTarget}"
                                                                           RadiusX="6"
                                                                           RadiusY="6"
                                                                           Fill="{StaticResource SurfaceAlt}"
                                                                           StrokeThickness="1"
                                                                           StrokeDashArray="4,3"/>
                                                                <Grid Margin="10,6" ColumnDefinitions="*,Auto,Auto">
                                                                    <StackPanel VerticalAlignment="Center"
                                                                                Margin="0,0,16,0">
                                                                        <TextBlock Classes="body">
                                                                            <Run Text="{Binding Name, Mode=OneWay}"
                                                                                 FontWeight="SemiBold"/><Run Text="{Binding Description, Mode=OneWay, StringFormat='{}  &#183;  {0}', TargetNullValue=''}"
                                                                                                             Foreground="{StaticResource TextMuted}"/>
                                                                        </TextBlock>
                                                                        <TextBlock Classes="muted"
                                                                                   Margin="0,2,0,0">
                                                                            <Run Text="Drag and drop "/><Run Text="{Binding DropTypes, Mode=OneWay}"
                                                                                                             Foreground="{StaticResource Text}"
                                                                                                             FontWeight="SemiBold"/><Run Text=" or folders here"/>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding CountText}"
                                                                               Classes="muted"
                                                                               VerticalAlignment="Center"
                                                                               Margin="0,0,12,0"/>
                                                                    <StackPanel Grid.Column="2"
                                                                                Orientation="Horizontal"
                                                                                VerticalAlignment="Center">
                                                                        <Button Classes="secondary"
                                                                                Padding="10,4"
                                                                                FontSize="12"
                                                                                Content="Add files..."
                                                                                Command="{Binding DataContext.AddResourceFilesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}"/>
                                                                        <Button Classes="secondary"
                                                                                Padding="10,4"
                                                                                FontSize="12"
                                                                                Margin="6,0,0,0"
                                                                                Content="Add folder..."
                                                                                Command="{Binding DataContext.AddResourceFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}"/>
                                                                        <Button Classes="secondary"
                                                                                Padding="10,4"
                                                                                FontSize="12"
                                                                                Margin="6,0,0,0"
                                                                                Content="Open folder"
                                                                                Command="{Binding DataContext.OpenResourceFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,7,0,0">
                                                    <Button Classes="link path"
                                                            Content="{Binding Location}"
                                                            ToolTip.Tip="Show this file in its folder"
                                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Mod.AssemblyPath}"/>
                                                    <TextBlock Text="  &#183;  "
                                                               Classes="muted"
                                                               FontSize="11"
                                                               IsVisible="{Binding HasUrl}"/>
                                                    <Button Classes="link"
                                                            FontSize="11"
                                                            Content="Website"
                                                            IsVisible="{Binding HasUrl}"
                                                            ToolTip.Tip="{Binding Url}"
                                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Url}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Top">
                                                <Button Classes="primary"
                                                        Padding="12,5"
                                                        FontSize="12"
                                                        Content="{Binding UpdateText}"
                                                        ToolTip.Tip="{Binding UpdateTooltip}"
                                                        IsVisible="{Binding HasUpdate}"
                                                        Command="{Binding DataContext.UpdateModCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Classes="ghost"
                                                        Content="Remove"
                                                        Margin="0,4,0,0"
                                                        HorizontalAlignment="Right"
                                                        Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <DockPanel IsVisible="{Binding IsIssuesPage}">
                    <Border DockPanel.Dock="Top"
                            Classes="card"
                            Margin="20,18,20,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center"
                                        Margin="0,0,14,0">
                                <TextBlock Text="{Binding HealthSummary}"
                                           Classes="heading"/>
                                <TextBlock Classes="muted"
                                           Margin="0,3,0,0"
                                           Text="{Binding QuarantineHint}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Classes="primary"
                                    Content="Fix everything"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding RepairableCount, Converter={StaticResource HasValue}}"
                                    Command="{Binding FixEverythingCommand}"/>
                        </Grid>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Padding="20,0,14,20">
                        <ItemsControl ItemsSource="{Binding Issues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="row">
                                        <Grid ColumnDefinitions="Auto,*,Auto">

                                            <Ellipse Width="9"
                                                     Height="9"
                                                     Margin="0,6,12,0"
                                                     VerticalAlignment="Top"
                                                     Fill="{Binding SeverityBrush}"/>

                                            <StackPanel Grid.Column="1"
                                                        Margin="0,0,14,0">
                                                <TextBlock Text="{Binding Title}"
                                                           Classes="heading"/>
                                                <SelectableTextBlock Text="{Binding Detail}"
                                                                     FontSize="13"
                                                                     TextWrapping="Wrap"
                                                                     Foreground="{StaticResource TextMuted}"
                                                                     SelectionBrush="{StaticResource Accent}"
                                                                     Margin="0,5,0,0"/>
                                                <Button Classes="link path"
                                                        Margin="0,6,0,0"
                                                        Content="{Binding Where}"
                                                        IsVisible="{Binding HasWhere}"
                                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Diagnostic.Path}"/>
                                            </StackPanel>

                                            <Button Grid.Column="2"
                                                    Classes="secondary"
                                                    VerticalAlignment="Top"
                                                    Padding="12,6"
                                                    FontSize="12"
                                                    Content="{Binding RepairLabel}"
                                                    ToolTip.Tip="{Binding RepairDescription}"
                                                    IsVisible="{Binding CanRepair}"
                                                    Command="{Binding DataContext.FixOneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <DockPanel IsVisible="{Binding IsBrowsePage}">
                    <Border DockPanel.Dock="Top"
                            Classes="card"
                            Margin="20,18,20,12">
                        <StackPanel>
                            <TextBlock Text="Get mods"
                                       Classes="heading"/>
                            <TextBlock Text="{Binding CatalogStatus}"
                                       Classes="muted"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding CatalogProblems}"
                                       Classes="muted"
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource Warning}"
                                       IsVisible="{Binding HasCatalogProblems}"/>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,12,0,0">
                                <Button Classes="secondary"
                                        Content="Install from zip..."
                                        Margin="0,0,8,0"
                                        Command="{Binding InstallFromFileCommand}"/>
                                <Button Classes="secondary"
                                        Content="Install from folder..."
                                        Margin="0,0,8,0"
                                        Command="{Binding InstallFromFolderCommand}"/>
                                <Button Classes="ghost"
                                        Content="Add a repository"
                                        ToolTip.Tip="Mod repositories are managed under Settings"
                                        Command="{Binding GoToCommand}"
                                        CommandParameter="Settings"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Padding="20,0,14,20">
                        <ItemsControl ItemsSource="{Binding Available}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="row">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Margin="0,0,14,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}"
                                                               Classes="heading"/>
                                                    <Border CornerRadius="9"
                                                            Padding="7,1"
                                                            Margin="9,2,0,0"
                                                            VerticalAlignment="Center"
                                                            Background="{StaticResource Accent}"
                                                            IsVisible="{Binding IsNew}">
                                                        <TextBlock Text="New"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding StateText}"
                                                               Classes="muted"
                                                               Margin="8,2,0,0"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Byline}"
                                                           Classes="muted"
                                                           Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding Description}"
                                                           Classes="body"
                                                           Foreground="{StaticResource TextMuted}"
                                                           Margin="0,6,0,0"/>
                                                <Button Classes="link"
                                                        FontSize="11"
                                                        Content="Website"
                                                        Margin="0,6,0,0"
                                                        IsVisible="{Binding HasHomepage}"
                                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Homepage}"/>
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Classes="primary"
                                                    VerticalAlignment="Top"
                                                    Padding="16,6"
                                                    Content="Install"
                                                    IsVisible="{Binding CanInstall}"
                                                    Command="{Binding DataContext.InstallCatalogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <DockPanel IsVisible="{Binding IsLogPage}">
                    <Border DockPanel.Dock="Top"
                            Classes="card"
                            Margin="20,18,20,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center"
                                        Margin="0,0,14,0">
                                <TextBlock Text="Loader log"
                                           Classes="heading"/>
                                <TextBlock Text="{Binding LogSummary}"
                                           Classes="muted"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <CheckBox Classes="switch"
                                          Margin="0,0,16,0"
                                          Content="Show only errors and warnings"
                                          Foreground="{StaticResource TextMuted}"
                                          IsChecked="{Binding LogProblemsOnly, Mode=TwoWay}"/>
                                <Button Classes="secondary"
                                        Content="Open log"
                                        IsVisible="{Binding HasLog}"
                                        Command="{Binding OpenCommand}"
                                        CommandParameter="{Binding LogPath}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Classes="card"
                            Margin="20,0,20,20"
                            Padding="4">
                        <Grid>
                            <ListBox Classes="log"
                                     ItemsSource="{Binding LogView}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Classes="mono"
                                                   TextWrapping="NoWrap"
                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelBrush}}">
                                            <Run Text="{Binding TimeText, Mode=OneWay}"
                                                 Foreground="{StaticResource TextFaint}"/><Run Text="  "/><Run Text="{Binding Source, Mode=OneWay}"
                                                                                                               Foreground="{StaticResource TextFaint}"/><Run Text="  "/><Run Text="{Binding Message, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="{Binding LogEmptyText}"
                                       Classes="muted"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       IsVisible="{Binding LogEmptyText, Converter={StaticResource HasValue}}"/>
                        </Grid>
                    </Border>
                </DockPanel>

                <ScrollViewer IsVisible="{Binding IsSettingsPage}"
                              VerticalScrollBarVisibility="Auto"
                              Padding="20,18,14,20">
                    <StackPanel MaxWidth="760"
                                HorizontalAlignment="Left">

                        <Border Classes="card"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Starting the game"
                                           Classes="heading"/>

                                <RadioButton x:Name="LaunchDirect"
                                             GroupName="launch"
                                             Margin="0,12,0,0"
                                             Classes="option"
                                             IsEnabled="{Binding CanLaunchDirectly}"
                                             IsCheckedChanged="OnLaunchModeChanged">
                                    <StackPanel>
                                        <TextBlock Text="Start the game directly"
                                                   Classes="body"/>
                                        <TextBlock Classes="muted"
                                                   Margin="0,2,0,0"
                                                   Text="{Binding DirectLaunchDescription}"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="LaunchSteam"
                                             GroupName="launch"
                                             Margin="0,10,0,0"
                                             Classes="option"
                                             IsCheckedChanged="OnLaunchModeChanged">
                                    <StackPanel>
                                        <TextBlock Text="Start through Steam"
                                                   Classes="body"/>
                                        <TextBlock Classes="muted"
                                                   Margin="0,2,0,0"
                                                   Text="{Binding SteamLaunchDescription}"/>
                                    </StackPanel>
                                </RadioButton>

                                <Border Background="{StaticResource WarningSoft}"
                                        CornerRadius="6"
                                        Padding="12,9"
                                        Margin="0,12,0,0"
                                        IsVisible="{Binding ShowSteamD3D11Hint}">
                                    <TextBlock Classes="body"
                                               FontSize="12"
                                               Text="Your Steam launch options do not include -force-d3d11. Set it in Steam (right-click the game, Properties, General, Launch Options), or use &quot;Start the game directly&quot; above."/>
                                </Border>

                                <Border Background="{StaticResource SurfaceAlt}"
                                        CornerRadius="6"
                                        Padding="12,9"
                                        Margin="0,12,0,0"
                                        IsVisible="{Binding ShowLaunchOption}">
                                    <StackPanel>
                                        <TextBlock Classes="body"
                                                   FontSize="12"
                                                   Text="{Binding LaunchOptionText}"/>
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                            <TextBox IsReadOnly="True"
                                                     Background="{StaticResource Bg}"
                                                     FontFamily="{StaticResource MonoFont}"
                                                     FontSize="12"
                                                     Text="{Binding RequiredLaunchOption, Mode=OneWay}"/>
                                            <Button Grid.Column="1"
                                                    Classes="secondary"
                                                    Content="Copy"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding CopyLaunchOptionCommand}"/>
                                        </Grid>
                                        <TextBlock Classes="muted"
                                                   Margin="0,6,0,0"
                                                   Text="{Binding LaunchOptionStatus}"
                                                   Foreground="{Binding LaunchOptionStatusBrush}"
                                                   IsVisible="{Binding LaunchOptionStatus, Converter={StaticResource HasValue}}"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Extra launch options"
                                           Classes="muted"
                                           Margin="0,16,0,5"/>
                                <TextBox x:Name="ExtraArgs"
                                         LostFocus="OnExtraArgsChanged"/>

                                <CheckBox x:Name="CloseOnLaunch"
                                          Classes="switch"
                                          Margin="0,14,0,0"
                                          Content="Close the manager after starting the game"
                                          IsCheckedChanged="OnCloseOnLaunchChanged"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="card"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Mod repositories"
                                           Classes="heading"/>
                                <TextBlock Classes="muted"
                                           Margin="0,4,0,0"
                                           Text="Only add repositories from authors you trust."/>

                                <ItemsControl ItemsSource="{Binding CatalogLists}"
                                              Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceAlt}"
                                                    CornerRadius="6"
                                                    Padding="12,9"
                                                    Margin="0,0,0,6">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Label}"
                                                                   Classes="body"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Url}"
                                                                   Classes="muted"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource TextFaint}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="NoWrap"
                                                                   ToolTip.Tip="{Binding Url}"
                                                                   Margin="0,1,0,0"/>
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   Classes="muted"
                                                                   FontSize="11"
                                                                   Foreground="{Binding StatusBrush}"
                                                                   Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Classes="ghost"
                                                            Content="Remove"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding CanRemove}"
                                                            Command="{Binding DataContext.RemoveCatalogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="Included by default"
                                                               Classes="muted"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding IsOfficial}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="0,6,0,0" ColumnDefinitions="*,Auto">
                                    <Grid>
                                        <TextBox Text="{Binding NewCatalogUrl, Mode=TwoWay}">
                                            <TextBox.KeyBindings>
                                                <KeyBinding Gesture="Enter"
                                                            Command="{Binding AddCatalogCommand}"/>
                                            </TextBox.KeyBindings>
                                        </TextBox>
                                        <TextBlock Text="https://example.com/mods.json"
                                                   Classes="muted"
                                                   Foreground="{StaticResource TextFaint}"
                                                   Margin="11,0,0,0"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   IsVisible="{Binding NewCatalogUrl, Converter={StaticResource HasNoValue}}"/>
                                    </Grid>
                                    <Button Grid.Column="1"
                                            Classes="secondary"
                                            Content="Add repository"
                                            Margin="8,0,0,0"
                                            Command="{Binding AddCatalogCommand}"/>
                                </Grid>
                                <TextBlock Text="{Binding CatalogInputError}"
                                           Classes="muted"
                                           Margin="0,6,0,0"
                                           Foreground="{StaticResource Warning}"
                                           IsVisible="{Binding CatalogInputError, Converter={StaticResource HasValue}}"/>

                                <CheckBox x:Name="ShowSafetyWarnings"
                                          Classes="switch"
                                          Margin="0,14,0,0"
                                          Content="Show safety warning when installing third party mods"
                                          IsCheckedChanged="OnShowSafetyWarningsChanged"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="card"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Updates"
                                           Classes="heading"/>
                                <TextBlock Classes="muted"
                                           Margin="0,4,0,0"
                                           Text="Notify when updates for the Mod Loader, Manager or installed mods are available."/>
                                <CheckBox x:Name="CheckOnStart"
                                          Classes="switch"
                                          Margin="0,12,0,0"
                                          Content="Check for updates on startup"
                                          IsCheckedChanged="OnCheckOnStartChanged"/>

                                <Border Background="{StaticResource SurfaceAlt}"
                                        CornerRadius="6"
                                        Padding="12,9"
                                        Margin="0,14,0,0"
                                        IsVisible="{Binding ManagerHasUpdate}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="{Binding ManagerUpdateSummary}"
                                                       Classes="body"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding ManagerUpdateNotes}"
                                                       Classes="muted"
                                                       Margin="0,6,0,0"
                                                       IsVisible="{Binding HasManagerUpdateNotes}"/>
                                            <TextBlock Classes="muted"
                                                       Margin="0,6,0,0"
                                                       Text="Updating will automatically restart the Mod Manager."/>
                                            <Button Classes="link"
                                                    FontSize="11"
                                                    Content="Release page"
                                                    Margin="0,6,0,0"
                                                    ToolTip.Tip="{Binding ManagerUpdatePageUrl}"
                                                    Command="{Binding OpenCommand}"
                                                    CommandParameter="{Binding ManagerUpdatePageUrl}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Classes="primary"
                                                VerticalAlignment="Top"
                                                Content="Update now"
                                                Command="{Binding UpdateManagerCommand}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Classes="card"
                                Margin="0,0,0,12"
                                IsVisible="{Binding ShowDesktopMenu}">
                            <StackPanel>
                                <TextBlock Text="Application menu"
                                           Classes="heading"/>
                                <Grid Margin="0,4,0,0" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="muted"
                                               Margin="0,0,12,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding DesktopMenuText}"/>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                VerticalAlignment="Top">
                                        <Button Classes="secondary"
                                                Content="{Binding AddToMenuLabel}"
                                                IsVisible="{Binding CanAddToMenu}"
                                                Command="{Binding AddToMenuCommand}"/>
                                        <Button Classes="ghost"
                                                Content="Remove from menu"
                                                IsVisible="{Binding IsInMenu}"
                                                Command="{Binding RemoveFromMenuCommand}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel>
                                <TextBlock Text="Folders and reporting"
                                           Classes="heading"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Classes="secondary"
                                            Content="Game folder"
                                            Margin="0,0,8,8"
                                            Command="{Binding OpenFolderCommand}"
                                            CommandParameter="Game"/>
                                    <Button Classes="secondary"
                                            Content="Mods folder"
                                            Margin="0,0,8,8"
                                            Command="{Binding OpenFolderCommand}"
                                            CommandParameter="Mods"/>
                                    <Button Classes="secondary"
                                            Content="Quarantine"
                                            Margin="0,0,8,8"
                                            ToolTip.Tip="Old files. Usually safe to delete"
                                            Command="{Binding OpenFolderCommand}"
                                            CommandParameter="Quarantine"/>
                                    <Button Classes="secondary"
                                            Content="Copy report"
                                            Margin="0,0,8,8"
                                            ToolTip.Tip="Copies a debugging report to the clipboard"
                                            Command="{Binding CopyReportCommand}"/>
                                </WrapPanel>
                                <TextBlock x:Name="ManagerVersionLabel"
                                           Classes="muted"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,1,0,0"
                Padding="20,9">
            <Grid MinHeight="16" ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Status}"
                           Classes="muted"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1"
                             Classes="busy"
                             IsIndeterminate="True"
                             IsVisible="{Binding Busy}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
