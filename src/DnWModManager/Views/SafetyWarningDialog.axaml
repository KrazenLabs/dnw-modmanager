<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DnWModManager.Views.SafetyWarningDialog"
        Width="480"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Assets/app.ico">

    <Grid RowDefinitions="Auto,Auto">
        <Grid ColumnDefinitions="Auto,*" Margin="22,22,22,20">
            <Border Width="36"
                    Height="36"
                    CornerRadius="18"
                    Background="{StaticResource WarningSoft}"
                    VerticalAlignment="Top"
                    Margin="0,0,14,0">
                <TextBlock Text="!"
                           Foreground="{StaticResource Warning}"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1">
                <TextBlock x:Name="WarningText"
                           Classes="heading"
                           Margin="0,8,0,0"/>
                <Border Background="{StaticResource SurfaceAlt}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,7"
                        Margin="0,12,0,0">
                    <TextBlock x:Name="SubjectText"
                               Classes="mono"/>
                </Border>
                <TextBlock Classes="muted"
                           Margin="0,12,0,0"
                           Text="You can turn this warning off in the settings."/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,1,0,0"
                Padding="22,12">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Classes="secondary"
                        Content="Cancel"
                        IsCancel="True"
                        IsDefault="True"
                        Margin="0,0,8,0"
                        Click="OnCancel"/>
                <Button x:Name="ConfirmButton"
                        Classes="primary"
                        Click="OnConfirm"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
