<Window x:Class="DnWModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DnW Mod Manager"
        Height="760"
        Width="1140"
        MinHeight="560"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="{StaticResource Surface}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Source="Assets/logo.png"
                       Width="38"
                       Height="38"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Margin="14,0,20,0"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="DnW Mod Manager"
                                   Style="{StaticResource Title}"/>
                        <Button Style="{StaticResource PrimaryButton}"
                                Padding="9,2"
                                FontSize="11"
                                Margin="10,2,0,0"
                                VerticalAlignment="Center"
                                Content="{Binding ManagerUpdateText}"
                                ToolTip="A new Mod Manager version is available. Click here to update."
                                Visibility="{Binding ManagerHasUpdate, Converter={StaticResource NullToCollapsed}}"
                                Command="{Binding UpdateManagerCommand}"/>
                        <Border Background="{StaticResource SurfaceAlt}"
                                CornerRadius="10"
                                Padding="8,2"
                                Margin="10,2,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding LoaderVersionText}"
                                       Style="{StaticResource Muted}"
                                       FontSize="11"/>
                        </Border>
                        <Button Style="{StaticResource PrimaryButton}"
                                Padding="9,2"
                                FontSize="11"
                                Margin="6,2,0,0"
                                VerticalAlignment="Center"
                                Content="{Binding LoaderUpdateText}"
                                ToolTip="Update the Mod Loader"
                                Visibility="{Binding LoaderHasUpdate, Converter={StaticResource NullToCollapsed}}"
                                Command="{Binding UpdateLoaderCommand}"/>
                    </StackPanel>

                    <DockPanel Margin="0,3,0,0"
                               HorizontalAlignment="Left"
                               LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource GhostButton}"
                                Content="Change"
                                Margin="8,0,0,0"
                                Command="{Binding ChangeGameFolderCommand}"/>
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding InstallSourceText}"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap"/>
                        <TextBlock DockPanel.Dock="Right"
                                   Text=" &#183; "
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap"/>
                        <Button Style="{StaticResource PathLink}"
                                FontSize="12"
                                VerticalAlignment="Center"
                                Content="{Binding GameDirectoryText}"
                                ToolTip="{Binding GameDirectoryText}"
                                Command="{Binding OpenFolderCommand}"
                                CommandParameter="Game"/>
                    </DockPanel>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}"
                            Content="Refresh"
                            Margin="0,0,8,0"
                            Command="{Binding RefreshCommand}"/>
                    <Button Style="{StaticResource PrimaryButton}"
                            Padding="24,9"
                            Command="{Binding LaunchCommand}"
                            ToolTip="Starts the game with -force-d3d11, which avoids the Direct3D 12 startup crash">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x25B6;"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="0,0,7,0"/>
                            <TextBlock Text="Play"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="188"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0,0,1,0">
                <StackPanel Margin="0,12">
                    <RadioButton Style="{StaticResource NavButton}"
                                 Content="Installed mods"
                                 GroupName="nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=Installed}"/>
                    <RadioButton Style="{StaticResource NavButton}"
                                 Content="Issues"
                                 GroupName="nav"
                                 Tag="{Binding IssueBadge}"
                                 Background="{Binding IssueBadgeBrush}"
                                 Visibility="{Binding HasIssues, Converter={StaticResource NullToCollapsed}}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=Issues}"/>
                    <RadioButton Style="{StaticResource NavButton}"
                                 Content="Get mods"
                                 GroupName="nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=Browse}"/>
                    <RadioButton Style="{StaticResource NavButton}"
                                 Content="Log"
                                 GroupName="nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=Log}"/>
                    <RadioButton Style="{StaticResource NavButton}"
                                 Content="Settings"
                                 GroupName="nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=Settings}"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">

                <!-- Installed mods -->
                <DockPanel Visibility="{Binding IsInstalledPage, Converter={StaticResource NullToCollapsed}}"
                           LastChildFill="True">

                    <!-- Only when something is wrong -->
                    <Border DockPanel.Dock="Top"
                            Style="{StaticResource Card}"
                            Margin="20,18,20,0"
                            Visibility="{Binding ShowHealthCard, Converter={StaticResource NullToCollapsed}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center"
                                        Margin="0,0,14,0">
                                <TextBlock Text="{Binding HealthSummary}"
                                           Style="{StaticResource Heading}"/>
                                <TextBlock Text="{Binding HealthHint}"
                                           Style="{StaticResource Muted}"
                                           Margin="0,3,0,0"
                                           Visibility="{Binding HasIssues, Converter={StaticResource NullToCollapsed}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButton}"
                                        Content="Install the loader"
                                        Margin="0,0,8,0"
                                        Visibility="{Binding LoaderMissing, Converter={StaticResource NullToCollapsed}}"
                                        Command="{Binding InstallLoaderCommand}"/>
                                <Button Style="{StaticResource SecondaryButton}"
                                        Content="View issues"
                                        Margin="0,0,8,0"
                                        Visibility="{Binding HasIssues, Converter={StaticResource NullToCollapsed}}"
                                        Command="{Binding GoToCommand}"
                                        CommandParameter="Issues"/>
                                <Button Style="{StaticResource PrimaryButton}"
                                        Content="Fix everything"
                                        Visibility="{Binding RepairableCount, Converter={StaticResource NullToCollapsed}}"
                                        Command="{Binding FixEverythingCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                Margin="20,18,20,12">
                        <Button Style="{StaticResource SecondaryButton}"
                                Content="Install from zip..."
                                Margin="0,0,8,0"
                                Command="{Binding InstallFromFileCommand}"
                                ToolTip="Pick a mod zip. The manager works out what is in it and puts each part where it belongs."/>
                        <Button Style="{StaticResource SecondaryButton}"
                                Content="Install from folder..."
                                Margin="0,0,8,0"
                                Command="{Binding InstallFromFolderCommand}"/>
                        <Button Style="{StaticResource PrimaryButton}"
                                Margin="0,0,8,0"
                                Visibility="{Binding HasUpdates, Converter={StaticResource NullToCollapsed}}"
                                Command="{Binding UpdateEverythingCommand}">
                            <TextBlock><Run Text="Update all ("/><Run Text="{Binding UpdateCount, Mode=OneWay}"/><Run Text=")"/></TextBlock>
                        </Button>
                        <Button Style="{StaticResource GhostButton}"
                                Content="Open Mods folder"
                                Command="{Binding OpenFolderCommand}"
                                CommandParameter="Mods"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Padding="20,0,14,20">
                        <ItemsControl ItemsSource="{Binding Mods}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Style="{StaticResource Switch}"
                                                      Margin="0,2,14,0"
                                                      VerticalAlignment="Top"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanToggle}"
                                                      ToolTip="{Binding ToggleTooltip}"/>

                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}"
                                                               Style="{StaticResource Heading}"/>
                                                    <TextBlock Text="{Binding Version}"
                                                               Style="{StaticResource Muted}"
                                                               Margin="7,2,0,0"
                                                               VerticalAlignment="Center"/>
                                                    <Border CornerRadius="9"
                                                            Padding="7,1"
                                                            Margin="9,2,0,0"
                                                            VerticalAlignment="Center"
                                                            Background="{StaticResource SurfaceAlt}">
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   FontSize="11"
                                                                   Foreground="{Binding StatusBrush}"/>
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Text="{Binding Byline}"
                                                           Style="{StaticResource Muted}"
                                                           Margin="0,2,0,0"/>

                                                <TextBlock Text="{Binding Description}"
                                                           Style="{StaticResource BodyText}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           Margin="0,6,12,0"
                                                           Visibility="{Binding Description, Converter={StaticResource NullToCollapsed}}"/>

                                                <ItemsControl ItemsSource="{Binding Issues}"
                                                              Margin="0,7,12,0"
                                                              Visibility="{Binding HasIssues, Converter={StaticResource NullToCollapsed}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal"
                                                                        Margin="0,0,0,3">
                                                                <Ellipse Width="6"
                                                                         Height="6"
                                                                         Margin="0,6,7,0"
                                                                         VerticalAlignment="Top"
                                                                         Fill="{Binding Severity, Converter={StaticResource SeverityBrush}}"/>
                                                                <TextBlock Text="{Binding Title}"
                                                                           Style="{StaticResource Muted}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,7,0,0">
                                                    <Button Style="{StaticResource PathLink}"
                                                            Content="{Binding Location}"
                                                            ToolTip="Show this file in Explorer"
                                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Mod.AssemblyPath}"/>
                                                    <TextBlock Text="  &#183;  "
                                                               Style="{StaticResource Muted}"
                                                               FontSize="11"
                                                               Visibility="{Binding HasUrl, Converter={StaticResource NullToCollapsed}}"/>
                                                    <Button Style="{StaticResource LinkButton}"
                                                            FontSize="11"
                                                            Content="Website"
                                                            Visibility="{Binding HasUrl, Converter={StaticResource NullToCollapsed}}"
                                                            ToolTip="{Binding Url}"
                                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Url}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Top">
                                                <Button Style="{StaticResource PrimaryButton}"
                                                        Padding="12,5"
                                                        FontSize="12"
                                                        Content="{Binding UpdateText}"
                                                        ToolTip="{Binding UpdateTooltip}"
                                                        Visibility="{Binding HasUpdate, Converter={StaticResource NullToCollapsed}}"
                                                        Command="{Binding DataContext.UpdateModCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource GhostButton}"
                                                        Content="Remove"
                                                        Margin="0,4,0,0"
                                                        HorizontalAlignment="Right"
                                                        Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- Issues -->
                <DockPanel Visibility="{Binding IsIssuesPage, Converter={StaticResource NullToCollapsed}}">
                    <Border DockPanel.Dock="Top"
                            Style="{StaticResource Card}"
                            Margin="20,18,20,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center"
                                        Margin="0,0,14,0">
                                <TextBlock Text="{Binding HealthSummary}"
                                           Style="{StaticResource Heading}"/>
                                <TextBlock Style="{StaticResource Muted}"
                                           Margin="0,3,0,0"
                                           Text="Nothing is deleted. Anything removed goes to Mods\_quarantine, so it can be put back."/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="Fix everything"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding RepairableCount, Converter={StaticResource NullToCollapsed}}"
                                    Command="{Binding FixEverythingCommand}"/>
                        </Grid>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Padding="20,0,14,20">
                        <ItemsControl ItemsSource="{Binding Issues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Width="9"
                                                     Height="9"
                                                     Margin="0,6,12,0"
                                                     VerticalAlignment="Top"
                                                     Fill="{Binding SeverityBrush}"/>

                                            <StackPanel Grid.Column="1"
                                                        Margin="0,0,14,0">
                                                <TextBlock Text="{Binding Title}"
                                                           Style="{StaticResource Heading}"/>
                                                <TextBlock Text="{Binding Detail}"
                                                           Style="{StaticResource BodyText}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           Margin="0,5,0,0"/>
                                                <Button Style="{StaticResource PathLink}"
                                                        Margin="0,6,0,0"
                                                        Content="{Binding Where}"
                                                        Visibility="{Binding HasWhere, Converter={StaticResource NullToCollapsed}}"
                                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Diagnostic.Path}"/>
                                            </StackPanel>

                                            <Button Grid.Column="2"
                                                    Style="{StaticResource SecondaryButton}"
                                                    VerticalAlignment="Top"
                                                    Padding="12,6"
                                                    FontSize="12"
                                                    Content="{Binding RepairLabel}"
                                                    ToolTip="{Binding RepairDescription}"
                                                    Visibility="{Binding CanRepair, Converter={StaticResource NullToCollapsed}}"
                                                    Command="{Binding DataContext.FixOneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- Get mods -->
                <DockPanel Visibility="{Binding IsBrowsePage, Converter={StaticResource NullToCollapsed}}">
                    <Border DockPanel.Dock="Top"
                            Style="{StaticResource Card}"
                            Margin="20,18,20,12">
                        <StackPanel>
                            <TextBlock Text="Get mods"
                                       Style="{StaticResource Heading}"/>
                            <TextBlock Text="{Binding CatalogStatus}"
                                       Style="{StaticResource Muted}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding CatalogProblems}"
                                       Style="{StaticResource Muted}"
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource Warning}"
                                       Visibility="{Binding HasCatalogProblems, Converter={StaticResource NullToCollapsed}}"/>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,12,0,0">
                                <Button Style="{StaticResource SecondaryButton}"
                                        Content="Install from zip..."
                                        Margin="0,0,8,0"
                                        Command="{Binding InstallFromFileCommand}"/>
                                <Button Style="{StaticResource SecondaryButton}"
                                        Content="Install from folder..."
                                        Margin="0,0,8,0"
                                        Command="{Binding InstallFromFolderCommand}"/>
                                <Button Style="{StaticResource GhostButton}"
                                        Content="Add a repository"
                                        ToolTip="Mod repositories are managed under Settings"
                                        Command="{Binding GoToCommand}"
                                        CommandParameter="Settings"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Padding="20,0,14,20">
                        <ItemsControl ItemsSource="{Binding Available}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,14,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}"
                                                               Style="{StaticResource Heading}"/>
                                                    <TextBlock Text="{Binding StateText}"
                                                               Style="{StaticResource Muted}"
                                                               Margin="8,2,0,0"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Byline}"
                                                           Style="{StaticResource Muted}"
                                                           Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding Description}"
                                                           Style="{StaticResource BodyText}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           Margin="0,6,0,0"/>
                                                <TextBlock Text="{Binding CannotInstallReason}"
                                                           Style="{StaticResource Muted}"
                                                           Foreground="{StaticResource Warning}"
                                                           Margin="0,6,0,0"
                                                           Visibility="{Binding CannotInstallReason, Converter={StaticResource NullToCollapsed}}"/>
                                                <Button Style="{StaticResource LinkButton}"
                                                        FontSize="11"
                                                        Content="Website"
                                                        Margin="0,6,0,0"
                                                        Visibility="{Binding HasHomepage, Converter={StaticResource NullToCollapsed}}"
                                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Homepage}"/>
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Style="{StaticResource PrimaryButton}"
                                                    VerticalAlignment="Top"
                                                    Padding="16,6"
                                                    Content="Install"
                                                    Visibility="{Binding CanInstall, Converter={StaticResource NullToCollapsed}}"
                                                    Command="{Binding DataContext.InstallCatalogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- Log -->
                <DockPanel Visibility="{Binding IsLogPage, Converter={StaticResource NullToCollapsed}}">
                    <Border DockPanel.Dock="Top"
                            Style="{StaticResource Card}"
                            Margin="20,18,20,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center"
                                        Margin="0,0,14,0">
                                <TextBlock Text="Loader log"
                                           Style="{StaticResource Heading}"/>
                                <TextBlock Text="{Binding LogSummary}"
                                           Style="{StaticResource Muted}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <CheckBox Style="{StaticResource Switch}"
                                          Margin="0,0,16,0"
                                          Content="Show only errors and warnings"
                                          Foreground="{StaticResource TextMuted}"
                                          IsChecked="{Binding LogProblemsOnly, Mode=TwoWay}"/>
                                <Button Style="{StaticResource SecondaryButton}"
                                        Content="Open log"
                                        Visibility="{Binding HasLog, Converter={StaticResource NullToCollapsed}}"
                                        Command="{Binding OpenCommand}"
                                        CommandParameter="{Binding LogPath}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}"
                            Margin="20,0,20,20"
                            Padding="4">
                        <Grid>
                            <ListBox ItemsSource="{Binding LogView}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background"
                                                Value="Transparent"/>
                                        <Setter Property="Padding"
                                                Value="6,1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource Mono}"
                                                   TextWrapping="NoWrap"
                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelBrush}}">
                                            <Run Text="{Binding TimeText, Mode=OneWay}"
                                                 Foreground="{StaticResource TextFaint}"/>
                                            <Run Text="  "/><Run Text="{Binding Source, Mode=OneWay}"
                                                                 Foreground="{StaticResource TextFaint}"/>
                                            <Run Text="  "/><Run Text="{Binding Message, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="{Binding LogEmptyText}"
                                       Style="{StaticResource Muted}"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding LogEmptyText, Converter={StaticResource NullToCollapsed}}"/>
                        </Grid>
                    </Border>
                </DockPanel>

                <!-- Settings -->
                <ScrollViewer Visibility="{Binding IsSettingsPage, Converter={StaticResource NullToCollapsed}}"
                              VerticalScrollBarVisibility="Auto"
                              Padding="20,18,14,20">
                    <StackPanel MaxWidth="760"
                                HorizontalAlignment="Left">

                        <Border Style="{StaticResource Card}"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Starting the game"
                                           Style="{StaticResource Heading}"/>

                                <RadioButton x:Name="LaunchDirect"
                                             GroupName="launch"
                                             Margin="0,12,0,0"
                                             Style="{StaticResource OptionRadio}"
                                             Checked="OnLaunchModeChanged">
                                    <StackPanel>
                                        <TextBlock Text="Start the game directly"
                                                   Style="{StaticResource BodyText}"/>
                                        <TextBlock Style="{StaticResource Muted}"
                                                   Margin="0,2,0,0"
                                                   Text="Always adds -force-d3d11, which avoids a Direct3D 12 startup crash."/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="LaunchSteam"
                                             GroupName="launch"
                                             Margin="0,10,0,0"
                                             Style="{StaticResource OptionRadio}"
                                             Checked="OnLaunchModeChanged">
                                    <StackPanel>
                                        <TextBlock Text="Start through Steam"
                                                   Style="{StaticResource BodyText}"/>
                                        <TextBlock Style="{StaticResource Muted}"
                                                   Margin="0,2,0,0"
                                                   Text="Uses Steam launch options. Please set -force-d3d11 there yourself."/>
                                    </StackPanel>
                                </RadioButton>

                                <Border Background="#33E8A33D"
                                        CornerRadius="6"
                                        Padding="12,9"
                                        Margin="0,12,0,0"
                                        Visibility="{Binding ShowSteamD3D11Hint, Converter={StaticResource NullToCollapsed}}">
                                    <TextBlock Style="{StaticResource BodyText}"
                                               FontSize="12"
                                               Text="Your Steam launch options do not include -force-d3d11. Set it in Steam (right-click the game, Properties, General, Launch Options), or use &quot;Start the game directly&quot; above."/>
                                </Border>

                                <TextBlock Text="Extra launch options"
                                           Style="{StaticResource Muted}"
                                           Margin="0,16,0,5"/>
                                <TextBox x:Name="ExtraArgs"
                                         LostFocus="OnExtraArgsChanged"/>

                                <CheckBox x:Name="CloseOnLaunch"
                                          Style="{StaticResource Switch}"
                                          Margin="0,14,0,0"
                                          Content="Close the manager after starting the game"
                                          Checked="OnCloseOnLaunchChanged"
                                          Unchecked="OnCloseOnLaunchChanged"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Mod repositories"
                                           Style="{StaticResource Heading}"/>
                                <TextBlock Style="{StaticResource Muted}"
                                           Margin="0,4,0,0"
                                           Text="Only add repositories from authors you trust."/>

                                <ItemsControl ItemsSource="{Binding CatalogLists}"
                                              Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceAlt}"
                                                    CornerRadius="6"
                                                    Padding="12,9"
                                                    Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Label}"
                                                                   Style="{StaticResource BodyText}"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Url}"
                                                                   Style="{StaticResource Muted}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource TextFaint}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="NoWrap"
                                                                   ToolTip="{Binding Url}"
                                                                   Margin="0,1,0,0"/>
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   Style="{StaticResource Muted}"
                                                                   FontSize="11"
                                                                   Foreground="{Binding StatusBrush}"
                                                                   Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Style="{StaticResource GhostButton}"
                                                            Content="Remove"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding CanRemove, Converter={StaticResource NullToCollapsed}}"
                                                            Command="{Binding DataContext.RemoveCatalogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="Included by default"
                                                               Style="{StaticResource Muted}"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding IsOfficial, Converter={StaticResource NullToCollapsed}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <TextBox Text="{Binding NewCatalogUrl, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Return"
                                                            Command="{Binding AddCatalogCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <TextBlock Text="https://example.com/mods.json"
                                                   Style="{StaticResource Muted}"
                                                   Foreground="{StaticResource TextFaint}"
                                                   Margin="11,0,0,0"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Visibility="{Binding NewCatalogUrl, Converter={StaticResource NullToVisible}}"/>
                                    </Grid>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource SecondaryButton}"
                                            Content="Add repository"
                                            Margin="8,0,0,0"
                                            Command="{Binding AddCatalogCommand}"/>
                                </Grid>
                                <TextBlock Text="{Binding CatalogInputError}"
                                           Style="{StaticResource Muted}"
                                           Margin="0,6,0,0"
                                           Foreground="{StaticResource Warning}"
                                           Visibility="{Binding CatalogInputError, Converter={StaticResource NullToCollapsed}}"/>

                                <CheckBox x:Name="ShowSafetyWarnings"
                                          Style="{StaticResource Switch}"
                                          Margin="0,14,0,0"
                                          Content="Show safety warning when installing third party mods"
                                          Checked="OnShowSafetyWarningsChanged"
                                          Unchecked="OnShowSafetyWarningsChanged"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Updates"
                                           Style="{StaticResource Heading}"/>
                                <TextBlock Style="{StaticResource Muted}"
                                           Margin="0,4,0,0"
                                           Text="The manager can look for updates of the mod loader, installed mods and the manager itself."/>
                                <CheckBox x:Name="CheckOnStart"
                                          Style="{StaticResource Switch}"
                                          Margin="0,12,0,0"
                                          Content="Check for updates on startup"
                                          Checked="OnCheckOnStartChanged"
                                          Unchecked="OnCheckOnStartChanged"/>

                                <Border Background="{StaticResource SurfaceAlt}"
                                        CornerRadius="6"
                                        Padding="12,9"
                                        Margin="0,14,0,0"
                                        Visibility="{Binding ManagerHasUpdate, Converter={StaticResource NullToCollapsed}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="{Binding ManagerUpdateSummary}"
                                                       Style="{StaticResource BodyText}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding ManagerUpdateNotes}"
                                                       Style="{StaticResource Muted}"
                                                       Margin="0,6,0,0"
                                                       Visibility="{Binding HasManagerUpdateNotes, Converter={StaticResource NullToCollapsed}}"/>
                                            <TextBlock Style="{StaticResource Muted}"
                                                       Margin="0,6,0,0"
                                                       Text="Updating will automatically restart the Mod Manager."/>
                                            <Button Style="{StaticResource LinkButton}"
                                                    FontSize="11"
                                                    Content="Release page"
                                                    Margin="0,6,0,0"
                                                    ToolTip="{Binding ManagerUpdatePageUrl}"
                                                    Command="{Binding OpenCommand}"
                                                    CommandParameter="{Binding ManagerUpdatePageUrl}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource PrimaryButton}"
                                                VerticalAlignment="Top"
                                                Content="Update now"
                                                Command="{Binding UpdateManagerCommand}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Folders and reporting"
                                           Style="{StaticResource Heading}"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Content="Game folder"
                                            Margin="0,0,8,8"
                                            Command="{Binding OpenFolderCommand}"
                                            CommandParameter="Game"/>
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Content="Mods folder"
                                            Margin="0,0,8,8"
                                            Command="{Binding OpenFolderCommand}"
                                            CommandParameter="Mods"/>
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Content="Quarantine"
                                            Margin="0,0,8,8"
                                            ToolTip="Everything the manager has removed is kept here"
                                            Command="{Binding OpenFolderCommand}"
                                            CommandParameter="Quarantine"/>
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Content="Copy report"
                                            Margin="0,0,8,8"
                                            ToolTip="Copies a summary of this install to the clipboard, for a bug report"
                                            Command="{Binding CopyReportCommand}"/>
                                </WrapPanel>
                                <TextBlock x:Name="ManagerVersionLabel"
                                           Style="{StaticResource Muted}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,1,0,0"
                Padding="20,9">
            <Grid MinHeight="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Status}"
                           Style="{StaticResource Muted}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1"
                             Width="120"
                             Height="3"
                             IsIndeterminate="True"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource Accent}"
                             Visibility="{Binding Busy, Converter={StaticResource NullToCollapsed}}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
